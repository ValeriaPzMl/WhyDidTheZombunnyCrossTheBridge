# Normalizar fin de línea en texto
* text=auto

# Archivos YAML de Unity: merge como texto
*.unity    text merge=unityyamlmerge eol=lf
*.prefab   text merge=unityyamlmerge eol=lf
*.asset    text=auto merge=unityyamlmerge
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.cs       text diff=csharp

# Assets binarios de Unity (TerrainData, LightingData, etc.)
*Terrain*.asset binary
LightingData.asset binary

# Binarios pesados -> Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
